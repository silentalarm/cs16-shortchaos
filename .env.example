# Copy to .env and fill in. Never commit .env.
#
# On a VPS this file is the only thing that needs a human: `cp .env.example .env`, set the three
# secrets below with `openssl rand -hex 16` (RCON_PASSWORD), `openssl rand -hex 24` (ADMIN_TOKEN) and
# the key from YouTube Studio, then `chmod 600 .env` and `bash infra/deploy.sh`. docs/deploy.md is
# the whole path from an empty VPS to a live stream.
#
# DonationAlerts OAuth application (register in the streamer account, Applications section)
DA_CLIENT_ID=
DA_CLIENT_SECRET=
DA_REDIRECT_URI=http://127.0.0.1:4318/oauth/callback
# oauth-user-show = profile, oauth-donation-index = donation history
DA_SCOPE=oauth-user-show oauth-donation-index

# Polling of GET /api/v1/alerts/donations, seconds (minimum 3). Three, not ten: a viewer who paid
# and sees nothing for ten seconds has already swiped past the Short.
DA_POLL_SEC=3

# RUB per unit of a foreign currency, JSON, merged over the built-in table
# (USD 90, EUR 100, KZT 0.18, BYN 27, UAH 2.2). Every conversion floors the result, so a rate
# that is too low costs the donor, never the owner. A currency without a rate is rejected.
# CURRENCY_RATES={"USD":92,"EUR":101}

# 1 = fake donation source, no network and no tokens needed
DA_MOCK=1
DA_MOCK_FILE=data/mock-donations.json

# Storage
DB_PATH=data/control.db
ACTIVITIES_PATH=config/activities.json
# The free rotation: one activity every `intervalSec` (180 = 3 minutes) with no donation, plus the
# list a chaos burst may fire. A bad code or a slot shorter than its effect stops the process.
AUTO_EVENTS_PATH=config/auto-events.json
# Overlay text the capture container draws (donations). Inside compose the control API writes it to
# the shared overlay volume and the stream container reads it; outside compose it is a plain folder.
OVERLAY_DIR=data/overlay

# The picture panel: the control API writes the whole interface (the score bar, both team tops, the
# bot on camera, the last donation, the countdown to the next free event) as small text files, and the capture
# container draws them with drawtext - no SVG, no rasteriser, no second ffmpeg input. UI_RENDER=0
# falls back to the drawtext donation layer below and to the plugin's own HUD (stcam_hud 1).
UI_RENDER=1
# How often the panel state is compared against the files last written for the encoder, in ms.
UI_INTERVAL_MS=200

# Game server RCON. Leave RCON_PASSWORD empty for a dry run: commands are only logged.
RCON_HOST=127.0.0.1
RCON_PORT=27015
RCON_PASSWORD=
RCON_TIMEOUT_MS=5000
# Game server slots. 20 bots (10 vs 10) plus one slot for the spectator camera and one spare:
# the camera is a real connection, so a quota that fills every slot locks it out.
MAXPLAYERS=22
# Starting map and the engine's mapcycle. The pool is fight-yard maps only, and every one of them is
# committed to infra/maps (see infra/maps/README.md), so a fresh clone has the whole rotation. A stock
# map here (de_dust2 and friends) is exactly what puts the stream back on a big empty map.
MAP=fy_iceworld
MAPCYCLE=fy_iceworld,fy_pool_day,fy_snow,fy_buzzkill,fy_aztec,fy_dustworld
# First person camera (plugins/stream_cam, pilot feature): 0 = the chase camera only, 1 = the capture
# client is cut into the followed bot's eyes for stcam_pov_sec (2.5 s) after that bot gets a kill.
# Flipping this and recreating the container is the whole switch - no rebuild, no code change.
STREAM_POV=0
# 0 = the chase camera only; 1 = the action camera: the capture client is cut into the followed bot's
# eyes while it shoots (2 s after the last round by default, then back to third person for the same
# time, so the picture alternates instead of strobing); 2 = the lens held for as long as the bot lives
# (the switch the picture is judged by). The weapon in that view is the bot's own v_ model, written into
# the camera client's `viewmodel` field by plugins/stream_cam, and its shoot/reload animation is
# relayed from the bot - so this is the first person picture, not an empty-handed observer mode.
STREAM_EYE=1
# Seconds in first person after the last shot, and the same time back in third person before the next
# cut: one number tunes the rhythm. STREAM_EYE_MAX caps one continuous window (0 = no ceiling), so a
# bot spraying a whole magazine hands the picture back on its own.
STREAM_EYE_SEC=2.0
STREAM_EYE_MAX=5.0


# Streaming (scripts/stream.ts). Unused by the control API.
YOUTUBE_STREAM_KEY=
# RTMPS on 443, not plain RTMP on 1935: some ISPs drop the 1935 flow right after the handshake
# packet ("Cannot read RTMP handshake response"), and YouTube recommends TLS anyway.
YOUTUBE_RTMP_URL=rtmps://a.rtmps.youtube.com:443/live2
# Autonomous capture container (infra/stream) reads these too:
# YOUTUBE_STREAM_KEY is the stream key from YouTube Studio, RTMP_INGEST_URL overrides the ingest
# URL (default rtmps://a.rtmps.youtube.com:443/live2). The older STREAM_RTMP name is ignored by
# compose now, so a stale plain-RTMP value in an existing .env cannot break the push.
RTMP_INGEST_URL=rtmps://a.rtmps.youtube.com:443/live2
# Name the spectator camera uses in game (shows up in the scoreboard, ASCII only).
STREAM_CAM_NAME=StreamCam
# desktop = Windows gdigrab, x11 = Linux Xvfb screen, test = synthetic pattern
STREAM_SOURCE=
STREAM_FPS=30
# Measured ceiling on 4 vCPU with software OpenGL (`docker stats` + ffmpeg `speed=`/`dup=`):
#   720x1280@30 -> fps 28, `drop` grows (the client cannot hold 30 at that canvas);
#   720x1280@45 -> fps 36, speed 0.96 (encoder starves the renderer);
#   640x1138@45 -> fps 45, dup 0, speed 1.01, xash3d+ffmpeg ~310% of 400%;
#   640x1138@50 -> fps 50, dup 0, ~330%, little headroom left for the game side.
# 45 fps at 640x1138 is the compromise this box sustains; a bigger VM buys the canvas back.
# Encoder threads. llvmpipe (software OpenGL, same container) and libx264 scale with the core count
# and starve each other; the cap keeps the render smooth at 720p30.
STREAM_ENCODE_THREADS=2
# Optional CPU pinning for the two heavy containers (compose `cpuset`): empty = every core is fair
# game. Correct values are per host - on a 12-thread machine `0-7` for the capture and `8-11` for
# the game server is a sane split. A cpuset naming a core the host does not have fails to start, so
# set these only after checking `nproc`.
# STREAM_CPUSET=0-7
# HLDS_CPUSET=8-11
# vertical = 9:16 canvas for the YouTube Shorts feed (default), horizontal = plain 16:9 passthrough.
STREAM_ORIENTATION=vertical
# Canvas the viewers get. The client renders at the canvas width, and the vertical layout derives the
# render height from the canvas and the band height, so that after the two spectator bands are cut off
# the picture fills the frame (720x2134 for the default canvas). STREAM_CAPTURE_HEIGHT is only honoured
# by `horizontal`.
STREAM_WIDTH=720
STREAM_HEIGHT=1280
# CS16Client paints a translucent band over the top and the bottom 20% of the frame (scores, map,
# nickname) and has no switch for it. The encoder cuts both bands off before scaling, which keeps the
# gameplay at its natural size; set to 0 to keep the bands.
STREAM_BAND_PERCENT=20
# Software OpenGL threads. llvmpipe uses every core it sees by default: measured 625% CPU for the
# client alone, which starved the encoder and left the browser player loading forever. 2 is enough
# at 960x720; raise it only if the picture at 30 fps is visibly not enough.
LP_NUM_THREADS=2
STREAM_BITRATE_KBPS=3000
# Capture window offset in the virtual desktop (desktop source only)
STREAM_OFFSET_X=0
STREAM_OFFSET_Y=0
# X display for the x11 source
STREAM_DISPLAY=:99
STREAM_KEYFRAME_SEC=2
STREAM_PRESET=veryfast
# Record to a file instead of going live: no stream key needed, the container exits when done.
# Any rtmp:// / tcp:// / udp:// / srt:// URL also works and pushes the same encoded stream there;
# the container format follows the scheme (rtmp -> flv, tcp/udp/srt -> mpegts, path -> matroska).
# Local debugging hub (docker compose --profile local-view up -d mediamtx):
#   STREAM_OUTPUT=rtmp://mediamtx:1935/live/test
# Watch it at http://localhost:8889/live/test (WebRTC, ~1 s) or http://localhost:8888/live/test (HLS).
STREAM_OUTPUT=
# Seconds of recording when STREAM_OUTPUT is set (0 = unlimited).
STREAM_RECORD_SEC=0
# Donation overlay: path of the text file the control API rewrites (compose sets /overlay/overlay.txt).
# Empty disables the drawtext layer; a missing font disables it too (fonts-dejavu-core is baked in).
STREAM_OVERLAY_TXT=
# Font size in pixels and the distance from the bottom edge. The vertical layout keeps 150 px free
# because the Shorts UI (title, buttons) covers the bottom strip.
STREAM_OVERLAY_FONTSIZE=26
STREAM_OVERLAY_MARGIN=150
# Optional explicit font path; by default DejaVuSans-Bold from the image is used.
STREAM_OVERLAY_FONT=
# The picture panel the control API writes (see UI_RENDER above). Inside compose these point at a
# subdirectory of the shared overlay volume, which the control API opens for the unprivileged capture
# container. One file per drawn line: bar-t/bar-ct (the score bar), score-t/score-ct (the frag
# counts drawn on its ends), top-t/top-ct, target, notice, last, next (the rotation countdown), chaos.
# STREAM_UI_TEXT=0 disables the panel; a missing file only means that line stays empty.
STREAM_UI_DIR=/overlay/ui
STREAM_UI_TEXT=1
# Font sizes in pixels of the 720x1280 frame. The bar is 20 blocks of U+2588: at 40 px they span
# 614 px, which fits between the two 52 px margins. Raise the size and the bar starts to be clipped.
STREAM_UI_SIZE_BAR=40
# The two frag counts drawn on the bar ends: smaller than the bar, else they cover the blocks.
STREAM_UI_SIZE_SCORE=28
STREAM_UI_SIZE_TOP=30
STREAM_UI_SIZE_TARGET=36
STREAM_UI_SIZE_LAST=26
STREAM_UI_SIZE_NEXT=24
# Side margin, and where the panel starts from the top and from the bottom (the Shorts UI owns the
# bottom ~150 px, so the last two lines sit above it).
STREAM_UI_MARGIN=52
STREAM_UI_TOP=36
STREAM_UI_BOTTOM=186
# ffmpeg colour syntax: 0xRRGGBB or a name. The two bars are the only coloured lines, in the colours
# the game uses for the health cross (red, terrorists) and the armour shield (blue, counter-terrorists).
STREAM_UI_COLOR_T=0xDD3333
STREAM_UI_COLOR_CT=0x3366DD
STREAM_UI_COLOR_TEXT=white
STREAM_UI_COLOR_MUTED=0xB9C2CF
# The rotation countdown: the line that promises the next free event. Gold by default, like the meter.
STREAM_UI_COLOR_NEXT=0xE0A856
# 0 hides the bottom strip (the meter, the last donation, the countdown) and draws only the race and
# the bot on camera - the Shorts strip stays clean. 1 is the full panel.
STREAM_UI_DONATE=1
# Seconds to wait for the client to join before the encoder starts (recording runs only).
STREAM_WARMUP_SEC=25
# ffmpeg log level. `info` prints the encoder progress (frame=, fps=, bitrate=) into the container
# log, which is how a "Preparing stream" on YouTube is told apart from an encoder that sends nothing.
STREAM_FFMPEG_LOGLEVEL=warning
# Live push: how long to wait for the capture client to connect, and how long to let it settle
# before ffmpeg starts (an RTMP server drops a publisher that sends nothing for 10 s).
STREAM_JOIN_TIMEOUT_SEC=90
STREAM_JOIN_SETTLE_SEC=12
# Spectator camera mode, must match stcam_mode in plugins/stream_cam: 1 = chase locked (third
# person), 4 = in the followed player's eyes. The director switches between the two by itself
# (stcam_pov), and the target is chosen by the game server, not by the client, so the old
# client-side spec_next cycling stays off: two directors fight each other.
#
STREAM_SPEC_MODE=1
STREAM_SPEC_SWITCH_SEC=0
# Watchdog (infra/stream/watchdog.sh): seconds between checks, seconds of client log silence that
# mean "not on the server", seconds between frozen-picture samples and how many static samples in a
# row restart the client (the pause between rounds is legitimately static).
CHECK_SEC=15
LOG_STALE_SEC=120
MOTION_SEC=20
FROZEN_STRIKES=4
FFMPEG_PATH=ffmpeg

# Operator panel (src/admin). Without ADMIN_TOKEN the panel does not start at all.
# It can send RCON commands, so it binds 127.0.0.1 and must not be exposed: on a VPS use an SSH tunnel.
ADMIN_TOKEN=
ADMIN_BIND=127.0.0.1
ADMIN_PORT=8080
# 1 = the panel may inject fake donations for debugging (tagged "sim" in the history).
ADMIN_SIM_ALLOWED=1
ADMIN_PUBLIC_DIR=public
# Runtime tweaks saved by the panel. The git-tracked config/activities.json stays the default.
ACTIVITIES_OVERRIDE_PATH=data/activities.override.json
# Directory with status.json + runtime.json + progress.txt from the capture container (inside compose: /game/.stream).
STREAM_STATUS_DIR=data/stream
# Where the embedded player pulls the picture from: the local MediaMTX hub, same host, given port.
STREAM_HLS_PORT=8888
STREAM_HLS_PATH=live/test

