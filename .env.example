# Copy to .env and fill in. Never commit .env.
# DonationAlerts OAuth application (register in the streamer account, Applications section)
DA_CLIENT_ID=
DA_CLIENT_SECRET=
DA_REDIRECT_URI=http://127.0.0.1:4318/oauth/callback
# oauth-user-show = profile, oauth-donation-index = donation history
DA_SCOPE=oauth-user-show oauth-donation-index

# Polling of GET /api/v1/alerts/donations, seconds (minimum 3)
DA_POLL_SEC=10

# 1 = fake donation source, no network and no tokens needed
DA_MOCK=1
DA_MOCK_FILE=data/mock-donations.json

# Storage
DB_PATH=data/control.db
ACTIVITIES_PATH=config/activities.json

# Game server RCON. Leave RCON_PASSWORD empty for a dry run: commands are only logged.
RCON_HOST=127.0.0.1
RCON_PORT=27015
RCON_PASSWORD=
RCON_TIMEOUT_MS=5000

# Streaming (scripts/stream.ts). Unused by the control API.
YOUTUBE_STREAM_KEY=
YOUTUBE_RTMP_URL=rtmp://a.rtmp.youtube.com/live2
# Autonomous capture container (infra/stream) reads these too:
# YOUTUBE_STREAM_KEY is the stream key from YouTube Studio, STREAM_RTMP overrides the ingest URL.
STREAM_RTMP=rtmp://a.rtmp.youtube.com/live2
# Name the spectator camera uses in game (shows up in the scoreboard, ASCII only).
STREAM_CAM_NAME=StreamCam
# desktop = Windows gdigrab, x11 = Linux Xvfb screen, test = synthetic pattern
STREAM_SOURCE=
STREAM_FPS=30
# vertical = 9:16 canvas for the YouTube Shorts feed (default), horizontal = plain 16:9 passthrough.
STREAM_ORIENTATION=vertical
# Output canvas (what viewers get) and render size (what the engine draws; keep it 4:3, the
# composition pads the frame). 720x1280 encodes in about 0.7 of a core, 1080x1920 needs ~1.5.
STREAM_WIDTH=720
STREAM_HEIGHT=1280
STREAM_CAPTURE_WIDTH=960
STREAM_CAPTURE_HEIGHT=720
# Software OpenGL threads. llvmpipe uses every core it sees by default: measured 625% CPU for the
# client alone, which starved the encoder and left the browser player loading forever. 2 is enough
# at 960x720; raise it only if the picture at 30 fps is visibly not enough.
LP_NUM_THREADS=2
STREAM_BITRATE_KBPS=2000
# Capture window offset in the virtual desktop (desktop source only)
STREAM_OFFSET_X=0
STREAM_OFFSET_Y=0
# X display for the x11 source
STREAM_DISPLAY=:99
STREAM_KEYFRAME_SEC=2
STREAM_PRESET=veryfast
# Record to a file instead of going live: no stream key needed, the container exits when done.
# Any rtmp:// / tcp:// / udp:// / srt:// URL also works and pushes the same encoded stream there;
# the container format follows the scheme (rtmp -> flv, tcp/udp/srt -> mpegts, path -> matroska).
# Local debugging hub (docker compose --profile local-view up -d mediamtx):
#   STREAM_OUTPUT=rtmp://mediamtx:1935/live/test
# Watch it at http://localhost:8889/live/test (WebRTC, ~1 s) or http://localhost:8888/live/test (HLS).
STREAM_OUTPUT=
# Seconds of recording when STREAM_OUTPUT is set (0 = unlimited).
STREAM_RECORD_SEC=0
# Seconds to wait for the client to join before the encoder starts (recording runs only).
STREAM_WARMUP_SEC=25
# Live push: how long to wait for the capture client to connect, and how long to let it settle
# before ffmpeg starts (an RTMP server drops a publisher that sends nothing for 10 s).
STREAM_JOIN_TIMEOUT_SEC=90
STREAM_JOIN_SETTLE_SEC=12
# Spectator camera mode: 4 = in the followed player's eyes, 6 = map overview (no gameplay).
# The camera target is chosen by the game server (plugins/stream_cam), not by the client, so the
# old client-side spec_next cycling is off. Set this above zero only if the server has no plugin:
# two directors fight each other.
STREAM_SPEC_MODE=4
STREAM_SPEC_SWITCH_SEC=0
# Watchdog (infra/stream/watchdog.sh): seconds between checks, seconds of client log silence that
# mean "not on the server", seconds between frozen-picture samples and how many static samples in a
# row restart the client (the pause between rounds is legitimately static).
CHECK_SEC=15
LOG_STALE_SEC=120
MOTION_SEC=20
FROZEN_STRIKES=4
FFMPEG_PATH=ffmpeg

# Operator panel (src/admin). Without ADMIN_TOKEN the panel does not start at all.
# It can send RCON commands, so it binds 127.0.0.1 and must not be exposed: on a VPS use an SSH tunnel.
ADMIN_TOKEN=
ADMIN_BIND=127.0.0.1
ADMIN_PORT=8080
# 1 = the panel may inject fake donations for debugging (tagged "sim" in the history).
ADMIN_SIM_ALLOWED=1
ADMIN_PUBLIC_DIR=public
# Runtime tweaks saved by the panel. The git-tracked config/activities.json stays the default.
ACTIVITIES_OVERRIDE_PATH=data/activities.override.json
# Directory with status.json + runtime.json + progress.txt from the capture container (inside compose: /game/.stream).
STREAM_STATUS_DIR=data/stream
# Where the embedded player pulls the picture from: the local MediaMTX hub, same host, given port.
STREAM_HLS_PORT=8888
STREAM_HLS_PATH=live/test

