# syntax=docker/dockerfile:1.7
# Autonomous game capture: an open-source GoldSrc engine (Xash3D-FWGS) renders the match on a
# virtual X display and ffmpeg pushes it to YouTube. No Steam login, no GPU, no human at the
# keyboard: Mesa llvmpipe rasterises on the CPU.
#
# Why Xash3D and not the retail client: the retail client needs a Steam account and a browser
# login on the streaming host, which is exactly what "autonomous" must avoid. Xash3D is GPLv3,
# speaks the same network protocol and loads the very same cstrike content we already ship for
# the server, so the stream shows the game we actually host.
#
# Why CS16Client for cl_dlls: Valve's client.so calls into Steam (SteamInternal_ContextInit) and
# aborts without a session. CS16Client is the open-source CS 1.6 client library for Xash3D.
#
# Why i386: HLDS content (app 90) ships 32-bit cl_dlls/client.so and dlls/mp.so. The amd64
# engine build only loads *_amd64.so twins that do not exist in that depot, so the engine has
# to be the i386 build.
#
# Why trixie and not bookworm (the game server's base): the current CS16Client build needs
# glibc 2.38+, bookworm has 2.36. The engine build is older and runs fine on the newer glibc.
# Video: Xvfb + Mesa llvmpipe. Audio: there is no sound card in a container, so PulseAudio runs
# with a null sink - the engine plays into it and ffmpeg records its `.monitor` source.
# The engine is an i386 binary, so the i386 PulseAudio client is required next to the amd64 daemon,
# otherwise SDL reports "sound system can't be initialized" and the recording is silent.
# The bundled SDL2 in the Xash3D release has no PulseAudio backend at all, only ALSA, so ALSA is
# pointed at PulseAudio in /etc/asound.conf: SDL -> libasound -> pcm_pulse -> the null sink.
ARG BASE_IMAGE=debian:trixie-slim

FROM ${BASE_IMAGE} AS runtime
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ENV DEBIAN_FRONTEND=noninteractive

RUN dpkg --add-architecture i386 \
 && apt-get update \
 && apt-get upgrade -y --no-install-recommends \
 && apt-get install -y --no-install-recommends \
      ca-certificates curl xz-utils \
      xvfb x11-utils xauth xdotool \
      libc6-i386 libstdc++6:i386 zlib1g:i386 \
      libpulse0:i386 libasound2t64:i386 libasound2-plugins:i386 \
      libgl1:i386 libglx-mesa0:i386 libgl1-mesa-dri:i386 \
      pulseaudio pulseaudio-utils \
      fonts-dejavu-core \
      ffmpeg procps tini \
 && rm -rf /var/lib/apt/lists/* \
 && printf 'pcm.!default {\n    type pulse\n}\nctl.!default {\n    type pulse\n}\n' > /etc/asound.conf

# URL and SHA256 come from infra/checksums.env (generated by update-checksums.ps1, never guessed).
ARG XASH_URL
ARG XASH_SHA256
ARG CS16CLIENT_URL
ARG CS16CLIENT_SHA256
RUN : "${XASH_URL:?XASH_URL missing - run infra/update-checksums.ps1 and pass --build-arg-file}" \
 && : "${XASH_SHA256:?XASH_SHA256 missing}" \
 && : "${CS16CLIENT_URL:?CS16CLIENT_URL missing}" \
 && : "${CS16CLIENT_SHA256:?CS16CLIENT_SHA256 missing}" \
 && curl -fsSL "$XASH_URL" -o /tmp/xash.tar.gz \
 && echo "${XASH_SHA256}  /tmp/xash.tar.gz" | sha256sum -c - \
 && mkdir -p /opt/xash \
 && tar -xzf /tmp/xash.tar.gz -C /opt/xash --strip-components=1 \
 && curl -fsSL "$CS16CLIENT_URL" -o /tmp/cs16c.tar.gz \
 && echo "${CS16CLIENT_SHA256}  /tmp/cs16c.tar.gz" | sha256sum -c - \
 && mkdir -p /opt/cs16client \
 && tar -xzf /tmp/cs16c.tar.gz -C /opt/cs16client cstrike/cl_dlls cstrike/extras.pk3 \
 && rm /tmp/xash.tar.gz /tmp/cs16c.tar.gz

COPY infra/stream/entrypoint.sh /usr/local/bin/stream-entrypoint.sh
COPY infra/stream/watchdog.sh /usr/local/bin/watchdog.sh
# /game is a named volume in compose. Creating it here with the right owner means Docker
# populates a fresh volume with that ownership, so the non-root user can write to it.
# The setuid bits that Debian ships (su, mount, passwd, ...) are useless here: the container runs
# as uid 10002 with no login and capability dropping, so they are stripped and the gate in
# infra/verify-stream.ps1 can require "no setuid binaries" instead of a whitelist.
RUN chmod +x /usr/local/bin/stream-entrypoint.sh /usr/local/bin/watchdog.sh \
 && find / -xdev -perm /6000 -type f -exec chmod -s {} + \
 && mkdir -p /game \
 && useradd --system --uid 10002 --home /game --shell /usr/sbin/nologin stream \
 && chown -R 10002:10002 /game
# The engine resolves its base directory from the binary location, so the entrypoint copies the
# engine next to valve/ and cstrike/ inside /game instead of running it from /opt/xash.
# llvmpipe spreads rasterisation over every core it can see: measured 625% CPU (of 12 cores) for the
# CS 1.6 client alone, which starved the encoder and made HLS segments arrive too late for the
# browser player to start. Two threads cost ~1.7 cores and look the same at 960x720; raise it only
# if the picture at 30 fps is visibly not enough.
ENV DISPLAY=:99 \
    LIBGL_ALWAYS_SOFTWARE=1 \
    GALLIUM_DRIVER=llvmpipe \
    SDL_AUDIODRIVER=dummy \
    XDG_RUNTIME_DIR=/tmp/xdg \
    LP_NUM_THREADS=2

USER 10002
WORKDIR /game

HEALTHCHECK --interval=30s --timeout=5s --start-period=120s --retries=3 \
  CMD ["/bin/sh", "-c", "pgrep -x xash3d >/dev/null && pgrep -x ffmpeg >/dev/null"]

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/stream-entrypoint.sh"]
